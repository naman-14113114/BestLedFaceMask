{
  "name": "trustpilotreview",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "dev:site": "pnpm --filter @trustpilotreview/site dev",
    "build:site": "pnpm --filter @trustpilotreview/site build",
    "verify": "node scripts/verify-tracking.mjs && node scripts/verify-routes.mjs && node scripts/verify-assets.mjs && node scripts/verify-ca-ranking.mjs"
  },
  "devDependencies": {
    "turbo": "^2.8.6",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  }
}
